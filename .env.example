# --- Email (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
EMAIL_TO=you@gmail.com

# --- Database ---
# Local venv runs use host port 5433. Docker services override this to db:5432.
DATABASE_URL=postgresql://news:news@localhost:5433/news

# --- LLM providers ---------------------------------------------------------
# The app uses Gemini. If a call fails you get a headlines-only digest for that category.
# Create a free key at aistudio.google.com and use a Flash / Flash-Lite
# model your key lists (names change; a wrong name gives HTTP 404).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Free tier is rate limited per minute and per day; the app waits/retries and falls back to headlines.
# GEMINI_MAX_INPUT=25
# GEMINI_LEAD_CHARS=900
# GEMINI_INTERVAL=7

# --- Digest shape ---
DIGEST_LANGUAGE=English
DIGEST_HOURS=7,16,22
TIMEZONE=Africa/Casablanca
MAX_STORIES_PER_CATEGORY=6
# Headlines per category in fallback / run-headlines mode
MAX_PER_CATEGORY=8