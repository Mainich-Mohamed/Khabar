<mjml lang="en">
  <mj-head>
    <mj-title>Khabar · Evening brief</mj-title>
    <mj-preview>Chip halves energy use, ceasefire talks resume, and the main port reopens.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, 'Segoe UI', Roboto, Arial, sans-serif" />
      <mj-text color="#101f1c" font-size="16px" line-height="1.5" padding="0" />
      <mj-class name="kicker" color="#f3c26b" font-size="12px" font-weight="700" letter-spacing="0.08em" />
      <mj-class name="section-head" font-size="13px" font-weight="700" letter-spacing="0.06em" padding="26px 0 12px" />
      <mj-class name="h2" font-size="18px" font-weight="700" line-height="1.3" />
      <mj-class name="muted" color="#4a5955" font-size="12px" />
    </mj-attributes>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .canvas, .paper, .paper > table, .paper td { background-color:#06120f !important; }
        .aside, .aside > table, .aside td { background-color:#14241f !important; }
        .ink div { color:#f1f4f3 !important; }
        .muted div, span.muted { color:#99a4a1 !important; }
        .link a, .tagc { color:#54a896 !important; }
        .rule p { border-top-color:#354541 !important; }
        .light-only { display:none !important; }
        .dark-only { display:inline-block !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#fbfcfb" css-class="canvas">

    <!-- Header: mark + wordmark left, edition right (mj-group keeps them side by side on phones) -->
    <mj-section padding="22px 28px 0" css-class="paper">
      <mj-group>
        <mj-column width="60%" vertical-align="middle">
          <mj-text css-class="ink" font-size="25px" font-weight="700">
            <img class="light-only" src="assets/mark-light.png" width="30" height="30" alt="" style="vertical-align:-7px;margin-right:8px"><img class="dark-only" src="assets/mark-dark.png" width="30" height="30" alt="" style="display:none;vertical-align:-7px;margin-right:8px">khabar
          </mj-text>
        </mj-column>
        <mj-column width="40%" vertical-align="middle">
          <mj-text css-class="muted" mj-class="muted" align="right" font-size="13px">Evening brief</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- Top story: full-bleed green band, same colour in light and dark -->
    <mj-section full-width="full-width" background-color="#0b5d4f" padding="24px 28px 12px">
      <mj-column>
        <mj-text mj-class="kicker">TOP STORY · TECH &amp; AI</mj-text>
        <mj-text color="#f7faf8" font-size="25px" font-weight="700" line-height="1.22" padding="8px 0 0">Chipmaker unveils a processor that halves energy use</mj-text>
        <mj-text color="#f7faf8" line-height="1.55" padding="10px 0 0">The new design cuts power draw in half for the same speed, and the first laptops using it are due next spring.</mj-text>
        <mj-text color="#f7faf8" line-height="1.55" padding="10px 0 0"><b>Why it matters:</b> Cheaper power bills for data centres and longer battery life for ordinary devices.</mj-text>
        <mj-text color="#f7faf8" font-size="13px" padding="2px 0 0">
          <a href="#" style="color:#f7faf8;text-decoration:underline;display:inline-block;padding:10px 14px 10px 0;line-height:24px">Source One</a><a href="#" style="color:#f7faf8;text-decoration:underline;display:inline-block;padding:10px 14px 10px 0;line-height:24px">Source Two</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Geopolitics (extra bottom padding so the band below doesn't crowd the last link) -->
    <mj-section padding="0 28px 20px" css-class="paper">
      <mj-column>
        <mj-text css-class="ink" mj-class="section-head"><span style="color:#cf7f00;font-size:11px">&#9679;</span>&nbsp; Geopolitics</mj-text>

        <mj-text css-class="ink">
          <div style="font-size:18px;font-weight:700;line-height:1.3"><span class="tagc" style="color:#0b5d4f;font-size:13px;margin-right:6px">Update</span>Ceasefire talks resume after a week of silence</div>
        </mj-text>
        <mj-text css-class="ink" padding="5px 0 0">Negotiators met again on Thursday and agreed to keep the lines open while a monitoring plan is drafted.</mj-text>
        <mj-text css-class="link" font-size="13px">
          <a href="#" style="color:#0b5d4f;text-decoration:underline;display:inline-block;padding:10px 14px 10px 0;line-height:24px">Source One</a><a href="#" style="color:#0b5d4f;text-decoration:underline;display:inline-block;padding:10px 14px 10px 0;line-height:24px">Source Three</a>
        </mj-text>
        <mj-divider css-class="rule" border-color="#e3e7e6" border-width="1px" padding="0 0 14px" />

        <mj-text css-class="ink" mj-class="h2">Main port reopens to cargo ships</mj-text>
        <mj-text css-class="ink" padding="5px 0 0">Container traffic restarted after two days of closure, with a backlog expected to clear by the weekend.</mj-text>
        <mj-text css-class="link" font-size="13px">
          <a href="#" style="color:#0b5d4f;text-decoration:underline;display:inline-block;padding:10px 14px 10px 0;line-height:24px">Source Two</a><span class="muted" style="color:#4a5955;font-size:12px">single source</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Did you know? Separate from the news: full-width warm band -->
    <mj-section full-width="full-width" background-color="#f6eedc" padding="24px 28px 22px" css-class="aside">
      <mj-column>
        <mj-text css-class="ink" mj-class="section-head" padding="0 0 12px"><span style="color:#cf7f00;font-size:11px">&#9679;</span>&nbsp; Did you know?</mj-text>
        <mj-text css-class="ink" mj-class="h2">Sea otters hold hands while sleeping</mj-text>
        <mj-text css-class="ink" padding="4px 0 0">Sea otters often rest in groups called rafts and hold hands so they do not drift apart while they sleep.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer: no unsubscribe, address or mission line (not provided / not verified) -->
    <mj-section padding="24px 28px 32px" css-class="paper">
      <mj-column>
        <mj-divider css-class="rule" border-color="#e3e7e6" border-width="1px" padding="0 0 14px" />
        <mj-text css-class="muted" mj-class="muted" line-height="1.5">AI-generated from the linked articles. Check the source before relying on a detail.</mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
